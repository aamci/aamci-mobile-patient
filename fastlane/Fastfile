# frozen_string_literal: true

# Répertoire racine du projet Flutter (parent du dossier fastlane/)
FLUTTER_ROOT = File.expand_path("..", __dir__)

APP_BUNDLE_ID    = "com.ibogha.patient"
APP_BUNDLE_ID_AN = "com.ibogha.patient"

before_all do
  Dir.chdir(FLUTTER_ROOT) { sh("flutter pub get") }
end

# ─── Android ─────────────────────────────────────────────────────────────────

platform :android do
  desc "Analyse statique + tests Flutter"
  lane :test do
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter analyze --no-fatal-infos")
      sh("flutter test")
    end
  end

  desc "Build AAB + déploiement Google Play Internal Testing"
  lane :beta do
    setup_signing_android
    write_gradle_properties
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter build appbundle --release --build-number=#{build_number}")
    end
    json_key = ENV["GOOGLE_PLAY_JSON_KEY"]
    UI.user_error!("GOOGLE_PLAY_JSON_KEY (GOOGLE_PLAY_PATIENT_JSON_KEY) n'est pas définie dans les variables GitLab CI.") if json_key.nil? || json_key.empty?

    is_file = File.exist?(json_key.strip)
    unless is_file
      require 'json'
      begin
        JSON.parse(json_key)
      rescue JSON::ParserError
        UI.user_error!("GOOGLE_PLAY_JSON_KEY n'est pas un JSON valide ni un chemin de fichier existant.")
      end
    end

    upload_to_play_store(
      track:                   "internal",
      aab:                     "#{FLUTTER_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key:                is_file ? json_key.strip : nil,
      json_key_data:           is_file ? nil : json_key,
      skip_upload_screenshots: true,
      skip_upload_images:      true,
      skip_upload_metadata:    true,
      release_status:          "completed"
    )
  end

  desc "Build AAB + déploiement Google Play (production)"
  lane :release do
    setup_signing_android
    write_gradle_properties
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter build appbundle --release --build-number=#{build_number}")
    end
    upload_to_play_store(
      track:                  "production",
      aab:                    "#{FLUTTER_ROOT}/build/app/outputs/bundle/release/app-release.aab",
      json_key_data:          ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      skip_upload_screenshots: true,
      skip_upload_images:      true,
      skip_upload_metadata:    true,
      release_status:          "draft"  # passe à "completed" après validation manuelle
    )
  end

  # Écrit gradle.properties avec des limites mémoire strictes (résiste à Flutter upgrade)
  private_lane :write_gradle_properties do
    File.write(File.join(FLUTTER_ROOT, "android", "gradle.properties"), <<~PROPS)
      org.gradle.jvmargs=-Xmx2g -XX:MaxMetaspaceSize=512m -XX:ReservedCodeCacheSize=256m
      org.gradle.daemon=false
      org.gradle.parallel=false
      android.useAndroidX=true
      kotlin.daemon.jvm.options=-Xmx512m -Xms64m
    PROPS
  end

  # Prépare le keystore et key.properties depuis les variables d'environnement CI
  private_lane :setup_signing_android do
    keystore_path = File.join(FLUTTER_ROOT, "android", "release.keystore")
    keystore_b64 = ENV["ANDROID_PATIENT_KEYSTORE_BASE64"] || ENV["ANDROID_KEYSTORE_BASE64"]
    UI.user_error!("ANDROID_PATIENT_KEYSTORE_BASE64 non définie") unless keystore_b64
    require "base64"
    File.binwrite(keystore_path, Base64.decode64(keystore_b64.gsub(/\s+/, '')))
    store_pw = ENV.fetch("ANDROID_STORE_PASSWORD")
    # PKCS12 keystores require key password == store password
    key_pw   = ENV.fetch("ANDROID_KEY_PASSWORD", store_pw)
    key_alias = ENV.fetch("ANDROID_KEY_ALIAS", "ibogha-patient")
    UI.message("=== Keystore debug ===")
    UI.message("Key alias used: #{key_alias}")
    sh("keytool -list -keystore #{keystore_path} -storepass '#{store_pw}' 2>&1 || true")
    File.write(
      File.join(FLUTTER_ROOT, "android", "key.properties"),
      [
        "storePassword=#{store_pw}",
        "keyPassword=#{key_pw}",
        "keyAlias=#{key_alias}",
        "storeFile=../release.keystore"
      ].join("\n")
    )
  end
end

# ─── iOS ─────────────────────────────────────────────────────────────────────

platform :ios do
  desc "Analyse statique + tests Flutter"
  lane :test do
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter analyze --no-fatal-infos")
      sh("flutter test")
    end
  end

  desc "Build IPA + déploiement TestFlight (beta)"
  lane :beta do
    setup_asc_api_key
    match(type: "appstore", readonly: true)
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    export_plist  = generate_export_options(build_number)
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter build ipa --release --build-number=#{build_number} --export-options-plist=#{export_plist}")
    end
    strip_simulator_slices
    upload_to_testflight(
      ipa:                              Dir["#{FLUTTER_ROOT}/build/ios/ipa/*.ipa"].first,
      skip_waiting_for_build_processing: true,
      changelog:                        "Build #{build_number} — #{last_git_commit[:message]}"
    )
  end

  desc "Build IPA + soumission App Store"
  lane :release do
    setup_asc_api_key
    match(type: "appstore", readonly: true)
    build_number = ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M"))
    export_plist  = generate_export_options(build_number)
    Dir.chdir(FLUTTER_ROOT) do
      sh("flutter build ipa --release --build-number=#{build_number} --export-options-plist=#{export_plist}")
    end
    strip_simulator_slices
    deliver(
      ipa:                Dir["#{FLUTTER_ROOT}/build/ios/ipa/*.ipa"].first,
      submit_for_review:  true,
      automatic_release:  false,
      force:              true,
      skip_screenshots:   true,
      skip_metadata:      true
    )
  end

  # Supprime le flag de plateforme iOS Simulator (platform 7) des binaires Mach-O
  # embarqués dans l'IPA. Nécessaire pour objective_c.framework et autres packages
  # Flutter qui partagent l'architecture arm64 entre device et simulator — lipo
  # ne peut pas distinguer les deux, xcrun vtool agit sur les platform flags.
  private_lane :strip_simulator_slices do
    ipa_path = Dir["#{FLUTTER_ROOT}/build/ios/ipa/*.ipa"].first
    UI.user_error!("IPA introuvable dans build/ios/ipa/") unless ipa_path

    tmp_dir = "#{FLUTTER_ROOT}/build/ios/ipa_strip_tmp"
    sh("rm -rf '#{tmp_dir}' && mkdir -p '#{tmp_dir}'")
    sh("cd '#{tmp_dir}' && unzip -q '#{ipa_path}'")

    Dir["#{tmp_dir}/Payload/Runner.app/Frameworks/**/*.framework",
        "#{tmp_dir}/Payload/Runner.app/Frameworks/**/*.dylib"].each do |fw|
      binary = File.directory?(fw) ? "#{fw}/#{File.basename(fw, '.framework')}" : fw
      next unless File.exist?(binary)

      # Vérifie si le binaire contient un build pour iOS Simulator (platform 7)
      build_info = `xcrun vtool -show-build '#{binary}' 2>/dev/null`
      next unless build_info.include?("IPHONE_SIMULATOR") || build_info =~ /platform\s+7\b/i

      UI.message("Suppression platform iOS Simulator de : #{File.basename(binary)}")
      sh("xcrun vtool -remove-build-version 7 -output '#{binary}' '#{binary}' 2>/dev/null || true")

      # Re-signe le binaire après modification
      identity = ENV["EXPANDED_CODE_SIGN_IDENTITY"] || "-"
      sh("codesign --force --sign '#{identity}' '#{binary}' 2>/dev/null || true")
    end

    stripped_ipa = ipa_path.sub(".ipa", "-stripped.ipa")
    sh("cd '#{tmp_dir}' && zip -qr '#{stripped_ipa}' Payload")
    sh("mv '#{stripped_ipa}' '#{ipa_path}'")
    sh("rm -rf '#{tmp_dir}'")
    UI.success("IPA strippée : #{File.basename(ipa_path)}")
  end

  # Configure l'API Key App Store Connect (évite le mot de passe Apple 2FA)
  private_lane :setup_asc_api_key do
    app_store_connect_api_key(
      key_id:              ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id:           ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
      key_content:         ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house:            false
    )
  end

  # Génère le fichier ExportOptions.plist dynamiquement (teamID depuis env)
  private_lane :generate_export_options do |options|
    plist_path = File.join(FLUTTER_ROOT, "ios", "ExportOptions.plist")
    File.write(plist_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
          <key>method</key>
          <string>app-store</string>
          <key>teamID</key>
          <string>#{ENV.fetch('APPLE_DEVELOPER_TEAM_ID')}</string>
          <key>signingStyle</key>
          <string>manual</string>
          <key>signingCertificate</key>
          <string>Apple Distribution</string>
          <key>provisioningProfiles</key>
          <dict>
              <key>#{APP_BUNDLE_ID}</key>
              <string>match AppStore #{APP_BUNDLE_ID}</string>
          </dict>
          <key>uploadBitcode</key>
          <false/>
          <key>compileBitcode</key>
          <false/>
          <key>uploadSymbols</key>
          <true/>
      </dict>
      </plist>
    PLIST
    plist_path
  end
end
